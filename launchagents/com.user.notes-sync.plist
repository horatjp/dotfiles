<?xml version="1.0" encoding="UTF-8"?>
<!-- どこ: ~/Library/LaunchAgents へリンクする dotfiles の LaunchAgent。
     何: notes-sync をログイン時に起動し、異常終了時に再起動する。
     なぜ: アプリを問わずメモを同期する。衝突時は停止ファイルの削除、別ブランチでは main 復帰を待つ。
     ログ: スクリプトが $HOME/Library/Logs/notes-sync.log に追記する。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.notes-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec /bin/bash "$HOME/dotfiles/scripts/notes-sync.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
