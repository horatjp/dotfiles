{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(wget:*)"
    ]
  },
  "enabledPlugins": {
    "runpod@runpod": false,
    "context-mode@context-mode": false
  },
  "extraKnownMarketplaces": {
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official"
      }
    }
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/hooks/usagebar-statusline.sh"
  },
  "skipDangerousModePermissionPrompt": true,
  "advisorModel": "fable",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillOverrides": {
    "turnstile-spin": "name-only",
    "cloudflare-one": "name-only",
    "cloudflare-one-migrations": "name-only",
    "sandbox-stable": "name-only",
    "sandbox-next": "name-only",
    "sandbox-migrate-to-next": "name-only",
    "durable-objects": "name-only",
    "agents-sdk": "name-only",
    "cloudflare-email-service": "name-only",
    "find-docs": "name-only"
  }
}
