# ~/.env のテンプレート — 実値は 1Password に保存し、ここには op:// 参照だけを書く
# 展開: .zshrc が起動時に openv (op inject) で展開してキャッシュする / 手動は `openv`
# 単発実行: op run --env-file ~/.env -- <cmd>
# <vault>/<item> は自分の 1Password の Vault 名 / アイテム名に置き換える
GEMINI_API_KEY=op://<vault>/<item>/GEMINI_API_KEY
ELEVENLABS_API_KEY=op://<vault>/<item>/ELEVENLABS_API_KEY
KLING_ACCESS_KEY=op://<vault>/<item>/KLING_ACCESS_KEY
ARK_API_KEY=op://<vault>/<item>/ARK_API_KEY
OPENAI_API_KEY=op://<vault>/<item>/OPENAI_API_KEY
ANTHROPIC_API_KEY=op://<vault>/<item>/ANTHROPIC_API_KEY
CF_AIG_TOKEN=op://<vault>/<item>/CF_AIG_TOKEN
GITHUB_PAT=op://<vault>/<item>/GITHUB_PAT
CF_WORKERS_AI_TOKEN=op://<vault>/<item>/CF_WORKERS_AI_TOKEN
XAI_API_KEY=op://<vault>/<item>/XAI_API_KEY
RUNPOD_API_KEY=op://<vault>/<item>/RUNPOD_API_KEY
KIMI_API_KEY=op://<vault>/<item>/KIMI_API_KEY
