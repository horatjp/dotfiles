# ~/.env のテンプレート — 実値は 1Password に保存し、ここには op:// 参照だけを書く
# 展開: .zshrc が起動時に openv (op inject) で展開してキャッシュする / 手動は `openv`
# 単発実行: op run --env-file ~/.env -- <cmd>
# <vault>/<item> は自分の 1Password の Vault 名 / アイテム名に置き換える
ANTHROPIC_API_KEY=op://Personal/dev-api-keys/ANTHROPIC_API_KEY
ARK_API_KEY=op://Personal/dev-api-keys/ARK_API_KEY
CF_AIG_TOKEN=op://Personal/dev-api-keys/CF_AIG_TOKEN
CF_WORKERS_AI_TOKEN=op://Personal/dev-api-keys/CF_WORKERS_AI_TOKEN
ELEVENLABS_API_KEY=op://Personal/dev-api-keys/ELEVENLABS_API_KEY
GEMINI_API_KEY=op://Personal/dev-api-keys/GEMINI_API_KEY
GITHUB_PAT=op://Personal/dev-api-keys/GITHUB_PAT
JQUANTS_API_KEY=op://Personal/dev-api-keys/JQUANTS_API_KEY
KIMI_API_KEY=op://Personal/dev-api-keys/KIMI_API_KEY
KLING_ACCESS_KEY=op://Personal/dev-api-keys/KLING_ACCESS_KEY
OPENAI_API_KEY=op://Personal/dev-api-keys/OPENAI_API_KEY
RUNPOD_API_KEY=op://Personal/dev-api-keys/RUNPOD_API_KEY
TENSORDOCK_API_KEY=op://Personal/dev-api-keys/TENSORDOCK_API_KEY
TENSORDOCK_API_TOKEN=op://Personal/dev-api-keys/TENSORDOCK_API_TOKEN
VAST_API_KEY=op://Personal/dev-api-keys/VAST_API_KEY
XAI_API_KEY=op://Personal/dev-api-keys/XAI_API_KEY
