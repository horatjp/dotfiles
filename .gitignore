# dotfiles: gitignore
# Purpose: keep OS/editor/tool-generated noise and common secrets out of version control.

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor swap / backups ---
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej

# --- Logs ---
*.log

# --- Common secrets (keep examples committed) ---
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.kdbx

# --- Tool caches ---
.direnv/
node_modules/
__pycache__/
*.py[cod]

# --- Third-party skills ---
# skills CLI (npx skills) で導入する外部配布スキルは追跡しない。
# 再インストール: install.sh の npx skills add 行を参照(--all は使わない)
agents/skills/agents-sdk/
agents/skills/ax/
agents/skills/find-docs/
agents/skills/cloudflare/
agents/skills/cloudflare-email-service/
agents/skills/cloudflare-one/
agents/skills/cloudflare-one-migrations/
agents/skills/durable-objects/
agents/skills/sandbox-stable/
agents/skills/sandbox-next/
agents/skills/sandbox-migrate-to-next/
agents/skills/turnstile-spin/
agents/skills/herdr/
agents/skills/web-perf/
agents/skills/workers-best-practices/
agents/skills/wrangler/

# --- ローカル専用スキル ---
# 手元でのみ使う(配布・共有しない)スキルは追跡しない。
agents/skills/character-studio/
agents/skills/fanclub-video/
agents/skills/video-production/
agents/skills/minimax-h3-video/
agents/skills/selfhost-video/
agents/skills/music-production/
agents/skills/product-design/

# --- Other ---
# リポジトリ直下のみ無視する(先頭の / でアンカー)。
# templates/ 配下のテンプレートが同梱する .github/ .claude/ は追跡対象。
/.github/
/.claude/
# agmsg が Pi の届け方の目印として置くマシンごとのファイル
/.pi/agmsg-delivery
.project-command-history/
